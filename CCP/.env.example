# Backend Configuration
PORT=8000
DEBUG=False
DATABASE_MODE=sqlite # Options: sqlite, firestore
SQLITE_DB_PATH=ids_analytics.db

# Google Cloud Platform (Optional for Cloud Run / Firestore)
GCP_PROJECT=your-gcp-project-id
GCP_REGION=us-central1
FIRESTORE_PREFIX=ids_

# Frontend URL
VITE_API_BASE=/api

